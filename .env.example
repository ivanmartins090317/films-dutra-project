# Copie para `.env.local` e preencha com os valores do projeto Supabase (Dashboard → Settings → API).
# Não commite `.env.local` nem chaves de serviço.

# URL pública do projeto (ex.: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (publicável no front; RLS protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional em dev: URL do site (útil para redirects em produção)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
