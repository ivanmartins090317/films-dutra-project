# Copie para `.env.local` e preencha com os valores do projeto Supabase (Dashboard → Settings → API).
# Não commite `.env.local` nem chaves de serviço.

# URL pública do projeto (ex.: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima / publishable (Dashboard → API; RLS protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternativa se o painel só mostrar "publishable":
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=



# Opcional em dev: URL do site (útil para redirects em produção)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth (Supabase): em Authentication → URL Configuration → Redirect URLs, inclua:
# http://localhost:3000/auth/callback
# https://<seu-dominio>/auth/callback

# --- Onboarding (Fase 4): `completeOnboardingAction` usa service role no servidor apenas ---
# SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (migrações: `npm run db:push`) — não commitar ---
# Access Token: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=
# Senha do banco: Dashboard → Project Settings → Database
# (o `supabase link` pode pedir interativamente se não estiver no .env)
# SUPABASE_DB_PASSWORD=
